#!/bin/sh
# ---------------------------------------------------------------------------
# x30e-apple-ui : Apple (HIG) look for luci-theme-argon on Ruijie RG-X30E
#
# Runs on first boot and again after every sysupgrade (package uci-defaults
# are re-installed by sysupgrade, and this file is absent from the preserved
# /etc, so it always executes). Deletes itself when done.
# ---------------------------------------------------------------------------

[ -f /etc/config/argon ] || touch /etc/config/argon

# make sure an anonymous global section exists
if ! uci -q get argon.@global[0] >/dev/null 2>&1; then
	uci -q add argon global
fi

# make sure argon stays the active theme even if the old config said otherwise
uci -q set luci.main.mediaurlbase='/luci-static/argon'
uci -q set luci.themes.Argon='/luci-static/argon'

# Apple system colors + frosted glass settings
uci -q set argon.@global[0].primary='#007AFF'
uci -q set argon.@global[0].dark_primary='#0A84FF'
uci -q set argon.@global[0].blur='20'
uci -q set argon.@global[0].blur_dark='20'
uci -q set argon.@global[0].transparency='0.72'
uci -q set argon.@global[0].transparency_dark='0.80'
uci -q set argon.@global[0].mode='normal'
uci -q set argon.@global[0].online_wallpaper='none'

uci -q commit argon
uci -q commit luci

exit 0
